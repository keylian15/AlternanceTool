# --- Accès à l'app ---
APP_PASSWORD=choisis-un-mot-de-passe-long
SESSION_SECRET=chaine-aleatoire-32-caracteres-minimum
CRON_SECRET=autre-chaine-aleatoire

# --- Base Postgres (Neon / Supabase), URL "pooled" ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Offres : La Bonne Alternance (token API) ---
LBA_API_TOKEN=

# --- Score + résumé : Gemini (clé gratuite Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Envoi des mails : Gmail avec mot de passe d'application ---
GMAIL_USER=toi@gmail.com
GMAIL_APP_PASSWORD=
APPLICANT_NAME=Prénom Nom
